// Turns the demo seed data (src/lib/data.ts) into db/seed.sql.
// Run with:  npm run db:seed-sql
import { writeFileSync } from "node:fs";
import { APPS, CURRENT_USER, DEVELOPER, NICHES, REQUESTS } from "../src/lib/data.ts";

const q = (v: unknown): string =>
  v === null || v === undefined ? "null"
  : typeof v === "number" || typeof v === "boolean" ? String(v)
  : Array.isArray(v) ? `array[${v.map(q).join(",")}]::text[]`
  : `'${String(v).replace(/'/g, "''")}'`;

const out: string[] = ["-- Generated by scripts/generate-seed-sql.mts. Do not edit by hand.", "begin;"];
const nicheId = (slug: string) => NICHES.findIndex((n) => n.slug === slug) + 1;

NICHES.forEach((n, i) => out.push(`insert into niches (id, slug, label, icon) values (${i + 1}, ${q(n.slug)}, ${q(n.label)}, ${q(n.icon)}) on conflict do nothing;`));

const people = new Set<string>([CURRENT_USER.handle, ...APPS.map((a) => a.developer), ...REQUESTS.map((r) => r.author.toLowerCase())]);
for (const p of people) {
  const dev = APPS.some((a) => a.developer === p);
  const skills = p === DEVELOPER.handle ? DEVELOPER.skills : [];
  out.push(`insert into users (id, name, role, skills) values (${q(p)}, ${q(p === DEVELOPER.handle ? DEVELOPER.name : p)}, ${q(dev ? "developer" : "user")}, ${q(skills)}) on conflict do nothing;`);
}
out.push(`insert into user_niches values (${q(CURRENT_USER.handle)}, 1), (${q(CURRENT_USER.handle)}, 2) on conflict do nothing;`);

for (const a of APPS) {
  out.push(
    `insert into apps (id, developer_id, name, tagline, description, icon_url, status, pricing_type, price_inr, security_score, licence, last_updated, users_count, rating_avg, verified, new_developer, keywords) values (` +
    [a.slug, a.developer, a.name, a.tagline, a.description, a.icon, a.status, a.pricingType, a.priceInr, a.securityScore, a.licence].map(q).join(", ") +
    `, now() - interval '${a.updatedDaysAgo} days', ${a.usersCount}, ${a.rating}, ${a.verified}, ${a.newDeveloper}, ${q(a.keywords)}) on conflict do nothing;`,
  );
  for (const n of a.niches) out.push(`insert into app_niches values (${q(a.slug)}, ${nicheId(n)}) on conflict do nothing;`);
  for (const r of a.reviews) {
    out.push(`insert into users (id, name) values (${q(r.name.toLowerCase())}, ${q(r.name)}) on conflict do nothing;`);
    out.push(`insert into reviews (app_id, user_id, rating, text, created_at) values (${q(a.slug)}, ${q(r.name.toLowerCase())}, ${r.rating}, ${q(r.text)}, now() - interval '${r.daysAgo} days');`);
  }
}

for (const r of REQUESTS) {
  out.push(
    `insert into requests (id, author_id, title, description, bounty_inr, status, linked_app_id, upvotes_count, created_at) values (` +
    [r.id, r.author.toLowerCase(), r.title, r.description, r.bountyInr, r.status, r.linkedAppSlug ?? null, r.upvotes].map(q).join(", ") +
    `, to_timestamp(${r.createdAt / 1000})) on conflict do nothing;`,
  );
  for (const n of r.niches) out.push(`insert into request_niches values (${q(r.id)}, ${nicheId(n)}) on conflict do nothing;`);
}
out.push("commit;");

writeFileSync(new URL("../db/seed.sql", import.meta.url), out.join("\n") + "\n");
console.log(`Wrote db/seed.sql (${out.length} statements)`);
